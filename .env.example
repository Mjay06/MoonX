# Server-only upstream configuration. No API keys are currently required.
JPL_HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
JPL_HORIZONS_TIMEOUT_MS=20000

# NASA PDS LOLA LDEM_75S_240M, product version V2.1.
NASA_LOLA_LABEL_URL=https://pds-geosciences.wustl.edu/lro/lro-l-lola-3-rdr-v1/lrolol_1xxx/data/lola_gdr/polar/float_img/ldem_75s_240m_float.lbl
NASA_LOLA_IMAGE_URL=https://pds-geosciences.wustl.edu/lro/lro-l-lola-3-rdr-v1/lrolol_1xxx/data/lola_gdr/polar/float_img/ldem_75s_240m_float.img
NASA_LOLA_TIMEOUT_MS=120000
NASA_LOLA_CACHE_DIR=.cache/lunar-dem
